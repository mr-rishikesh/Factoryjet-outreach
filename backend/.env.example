# ============================================
# FactoryJet Email Outreach - Environment Variables
# ============================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to git (it's in .gitignore)

# ============================================
# MongoDB Configuration
# ============================================
# Cloud (Atlas) - Recommended for production
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# OR Local MongoDB - for development
# MONGO_URI=mongodb://127.0.0.1:27017/factoryjet

# ============================================
# Email Service Configuration
# ============================================
# Gmail or custom SMTP server credentials
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

# Email sender display name
EMAIL_FROM_NAME=Your Company Name

# ============================================
# AI Service Configuration
# ============================================
# Groq API Key for AI-powered email generation
GROQ_API_KEY=gsk_your_api_key_here

# ============================================
# Application URLs
# ============================================
# Base URL for unsubscribe and tracking links
BASE_URL=http://localhost:5000

# ============================================
# Scheduled Email Configuration
# ============================================
# Cron schedule for automated email sends
# Format: "minute hour day_of_month month day_of_week"
# Examples:
# - "0 * * * *" = Every hour at :00
# - "0 9 * * 1-5" = Weekdays at 9 AM
# - "0 9,14 * * *" = Daily at 9 AM and 2 PM
CRON_SCHEDULE=0 * * * *

# Maximum emails to send per day
DAILY_SEND_LIMIT=50

# Days of week to allow sends (0=Sunday, 6=Saturday)
# Example: "2,3" = Tuesday and Wednesday only
SEND_DAYS=2,3

# Hours of day to allow sends (24-hour format)
SEND_HOUR_START=7
SEND_HOUR_END=11

# ============================================
# Webhook Configuration (Optional)
# ============================================
# Secret for validating bounce webhooks
BOUNCE_WEBHOOK_SECRET=your-random-secret-key-here

# ============================================
# Debug Configuration (Optional)
# ============================================
# Set to "true" to enable verbose logging
DEBUG=false

# ============================================
# Notes
# ============================================
# 1. Never commit .env to git
# 2. Use different values for dev/staging/production
# 3. Rotate API keys periodically
# 4. Keep credentials secure and private
# 5. For Gmail, use App-specific passwords, not your regular password
#    See: https://support.google.com/accounts/answer/185833
